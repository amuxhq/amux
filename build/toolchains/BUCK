# Linux targets build with the Linux toolchain (nix.bzl), which also sends
# their actions to a Linux worker; everything else with the tools below.
# Android's Rust builds on Linux too, with the Linux toolchain's rustc (it
# carries the Android standard libraries) and the NDK's compilers. So does
# Windows: its genrules with the Linux toolchain, its compiles and links
# with the Windows one (_NIX_COMPILE).
_NIX = select({
    "DEFAULT": select({
        "DEFAULT": None,
        "prelude//os:linux": "root//:nix-linux",
        "root//build/constraints:on-linux": "root//:nix-linux",
        "prelude//os:android": "root//:nix-linux",
        "prelude//os:windows": "root//:nix-linux",
    }),
    # A release build uses this machine's own toolchains
    # (build/constraints:local-build).
    "root//build/constraints:local-build": None,
})

_NIX_COMPILE = select({
    "DEFAULT": _NIX,
    "prelude//os:windows": select({
        "DEFAULT": "root//:nix-windows",
        "root//build/constraints:local-build": None,
    }),
})

# A release build's C tools are this machine's own: on Windows MSVC's,
# which the prelude finds with vswhere; on Linux whichever `cc` and `c++`
# are on PATH (GCC on CI's runner, as Cargo's release builds linked with);
# on a Mac Xcode's, as always.
_LOCAL = read_root_config("amux", "local", "false") == "true"

_LOCAL_WINDOWS = _LOCAL and host_info().os.is_windows

_LOCAL_LINUX = _LOCAL and host_info().os.is_linux

# The Windows toolchain's tools (nix/windows.nix) where the C toolchain
# looks for GCC's names: LLVM's MSVC-compatible ones, which take cl.exe's,
# link.exe's and lib.exe's arguments. The compiler is declared as cl.exe
# ("windows"), not clang-cl: for clang-cl the prelude passes
# `-Xclang -fdebug-compilation-dir -Xclang <dir>` one argument per line of
# a response file, and clang-cl then finds -Xclang with no value.
_WINDOWS_TOOLS = {
    "bin/ar": "bin/llvm-lib",
    "bin/c++": "bin/clang-cl",
    "bin/cc": "bin/clang-cl",
    "bin/nm": "bin/llvm-nm",
    "bin/objcopy": "bin/llvm-objcopy",
    "bin/objdump": "bin/llvm-objdump",
    "bin/ranlib": "bin/llvm-ranlib",
    "bin/strip": "bin/llvm-strip",
}

# The cores a Linux test that uses every core asks for. It has to be the
# same wherever the test is sent from, or the same test would have two
# keys, and no more than nova's worker offers any scheduler it registers
# with; it is a minimum, so a bigger worker still takes it.
_LINUX_WHOLE_WORKER = read_root_config("amux", "linux_worker_cores", "8")

# The cores the Windows CI job's worker offers: GitHub's Windows runner has
# four.
_WINDOWS_WHOLE_WORKER = "4"

# C for a phone or the simulator (a crate's C, such as ring's) is compiled for
# that target against its SDK: /usr/bin/clang would otherwise build it for
# this Mac. scripts/buck-config.py writes where the selected Xcode keeps each
# SDK, so an Xcode upgrade changes these actions' keys too.
_IOS_C_FLAGS = select({
    "DEFAULT": [],
    "prelude//os:iphoneos": select({
        "DEFAULT": ["-target", "arm64-apple-ios26.0", "-isysroot", read_root_config("apple", "iphoneos_sdk", "")],
        "root//build/constraints:simulator": ["-target", "arm64-apple-ios26.0-simulator", "-isysroot", read_root_config("apple", "iphonesimulator_sdk", "")],
    }),
})

# Xcode's clang through /usr/bin, which finds the selected Xcode and its SDK.
# The Xcode version is in every Mac action's platform properties
# (build/platforms/BUCK), so an Xcode upgrade changes their keys.
amux_cxx_toolchain(
    name = "cxx",
    archiver = "ar" if _LOCAL_LINUX else "/usr/bin/ar",
    compiler = "cc" if _LOCAL_LINUX else "/usr/bin/clang",
    compiler_type = select({"DEFAULT": "clang", "prelude//os:linux": "gcc", "prelude//os:windows": "windows"}),
    archiver_type = select({"DEFAULT": None, "prelude//os:windows": None if _LOCAL_WINDOWS else "windows_clang"}),
    tools = "prelude//toolchains/msvc:msvc_tools" if _LOCAL_WINDOWS else None,
    # The C runtime as a DLL, as Rust's own Windows code and the `cc`
    # crate's builds link it: clang-cl alone would pick the static one, and
    # one binary would then carry both. A phone's or the simulator's C is
    # compiled for it (_IOS_C_FLAGS).
    c_flags = _IOS_C_FLAGS + select({"DEFAULT": [], "prelude//os:windows": ["/MD"]}),
    cxx_flags = _IOS_C_FLAGS + select({"DEFAULT": [], "prelude//os:windows": ["/MD"]}),
    cxx_compiler = "c++" if _LOCAL_LINUX else "/usr/bin/clang++",
    # WebAssembly links with the lld the pinned Rust ships, as Cargo's wasm32
    # builds do; rustc tells it which flavour.
    linker = select({
        "DEFAULT": "c++" if _LOCAL_LINUX else "/usr/bin/clang++",
        "prelude//os:none": "{}/lib/rustlib/{}/bin/rust-lld".format(
            read_root_config("rust", "toolchain_dir", ""),
            "aarch64-apple-darwin" if host_info().os.is_macos else "x86_64-unknown-linux-gnu",
        ),
    }),
    linker_type = select({"DEFAULT": None, "prelude//os:none": "wasm", "prelude//os:windows": "windows"}),
    # The same for WebAssembly under the Linux toolchain: its Rust's lld.
    nix_linker = select({
        "DEFAULT": "bin/c++",
        "prelude//os:none": "lib/rustlib/x86_64-unknown-linux-gnu/bin/rust-lld",
        "prelude//os:windows": "bin/lld-link",
    }),
    nix = select({
        "DEFAULT": _NIX_COMPILE,
        "prelude//os:android": "root//:nix-android",
    }),
    nix_paths = select({
        "DEFAULT": {},
        "prelude//os:windows": _WINDOWS_TOOLS,
        "prelude//os:android": select({
            "prelude//cpu:arm64": ndk_tools("aarch64-linux-android"),
            "prelude//cpu:x86_64": ndk_tools("x86_64-linux-android"),
        }),
    }),
    visibility = ["PUBLIC"],
)

# Cargo.toml's profiles, one per value of the `mode` constraint. Cargo sets
# debug assertions and overflow checks explicitly per profile, so they are
# explicit here too rather than left to rustc's opt-level-based defaults.
_DEV = ["-Copt-level=0", "-Cdebuginfo=0", "-Cdebug-assertions=on", "-Coverflow-checks=on"]

_MODE_RUSTC_FLAGS = select({
    "DEFAULT": _DEV,
    "root//build/constraints:models": ["-Copt-level=3", "-Cdebuginfo=0", "-Cdebug-assertions=on", "-Coverflow-checks=on"],
    "root//build/constraints:full-debug": ["-Copt-level=0", "-Cdebuginfo=2", "-Cdebug-assertions=on", "-Coverflow-checks=on"],
    "root//build/constraints:release": ["-Copt-level=3", "-Ccodegen-units=1", "-Cdebuginfo=line-tables-only", "-Cpanic=abort", "-Cdebug-assertions=off", "-Coverflow-checks=off", "-Cembed-bitcode=yes"],
    "root//build/constraints:phone-dev": ["-Copt-level=3", "-Ccodegen-units=16", "-Cdebuginfo=0", "-Cpanic=abort", "-Cdebug-assertions=off", "-Coverflow-checks=off"],
    "root//build/constraints:wasm": ["-Copt-level=s", "-Ccodegen-units=1", "-Cdebuginfo=0", "-Cpanic=abort", "-Cdebug-assertions=off", "-Coverflow-checks=off", "-Cembed-bitcode=yes"],
})

# Fat LTO applies where Cargo applies it: when the final artifact is linked.
_MODE_BINARY_FLAGS = select({
    "DEFAULT": [],
    "root//build/constraints:release": ["-Clto=fat"],
    "root//build/constraints:wasm": ["-Clto=fat", "-Cstrip=symbols"],
})

_PANIC_RUNTIME = select({
    "DEFAULT": "unwind",
    "root//build/constraints:release": "abort",
    "root//build/constraints:phone-dev": "abort",
    "root//build/constraints:wasm": "abort",
})

# .cargo/config.toml: Apple targets keep debug info in a packed .dSYM.
_TARGET_RUSTC_FLAGS = select({
    "DEFAULT": [],
    "prelude//os:macos": ["-Csplit-debuginfo=packed"],
    "prelude//os:iphoneos": ["-Csplit-debuginfo=packed"],
})

amux_rust_toolchain(
    name = "rust",
    default_edition = "2024",
    panic_runtime = _PANIC_RUNTIME,
    rustc_binary_flags = _MODE_BINARY_FLAGS,
    rustc_flags = _MODE_RUSTC_FLAGS + _TARGET_RUSTC_FLAGS,
    rustc_target_triple = RUST_TARGET_TRIPLE,
    # Cargo.toml's [workspace.lints.clippy] and clippy.toml, wherever clippy
    # runs (build/checks/clippy.py runs it over the workspace's crates).
    clippy_toml = "root//:clippy.toml",
    deny_lints = ["clippy::await_holding_lock", "clippy::dbg_macro", "clippy::todo"],
    toolchain_dir = read_root_config("rust", "toolchain_dir"),
    nix = _NIX_COMPILE,
    visibility = ["PUBLIC"],
)

amux_genrule_toolchain(
    name = "genrule",
    nix = _NIX,
    visibility = ["PUBLIC"],
)

system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    visibility = ["PUBLIC"],
)

remote_python_toolchain(
    name = "python",
    bootstrap = False,
    visibility = ["PUBLIC"],
)

# Tests run through NativeLink like every other action, so a passing result
# is in the action cache for every other worktree. Without this profile the
# prelude runs tests in Buck2's local executor, whose results are never
# uploaded.
remote_test_execution_toolchain(
    name = "remote_test_execution",
    default_profile = "default",
    # One action per test target; the target's own runner isolates cases.
    default_run_as_bundle = True,
    # A Linux test runs on a Linux worker, the rest on the Mac's.
    profiles = select({
        "DEFAULT": {
            "default": {
                "capabilities": {
                    "OSFamily": "macos",
                    "cpu_count": "1",
                    "xcode": read_root_config("apple", "xcode", ""),
                },
                "use_case": "buck2-default",
            },
            # A test that uses every core, as nextest's `threads-required =
            # "num-cpus"`: it reserves the whole worker, so nothing runs
            # beside it.
            "whole-worker": {
                "capabilities": {
                    "OSFamily": "macos",
                    "cpu_count": read_root_config("amux", "worker_cores", "1"),
                    "xcode": read_root_config("apple", "xcode", ""),
                },
                "use_case": "buck2-default",
            },
        },
        "prelude//os:linux": {
            "default": {
                "capabilities": {"OSFamily": "linux", "cpu_count": "1"},
                "use_case": "buck2-default",
            },
            "whole-worker": {
                "capabilities": {"OSFamily": "linux", "cpu_count": _LINUX_WHOLE_WORKER},
                "use_case": "buck2-default",
            },
        },
        # On the Windows CI job's own worker (build/platforms/BUCK), the
        # only place a Windows test can run. Every Windows test binary takes
        # the whole worker, its runner four cases at a time: four at once
        # is what the runner's four cores ran under nextest, and the Windows
        # tests have failed on timing under more load than that.
        "prelude//os:windows": {
            "default": {
                "capabilities": {"OSFamily": "windows", "cpu_count": _WINDOWS_WHOLE_WORKER},
                "use_case": "buck2-default",
            },
            "whole-worker": {
                "capabilities": {"OSFamily": "windows", "cpu_count": _WINDOWS_WHOLE_WORKER},
                "use_case": "buck2-default",
            },
        },
    }),
    visibility = ["PUBLIC"],
)

noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)

# Its zip tool is a Java program, run like the Android toolchains below.
zip_file_toolchain(
