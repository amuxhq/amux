{
  "about": "Provider subagents write their parts into the host's steps: a start naming the call that started it, its own items, appends, snapshot and asks, and an end. A person's answer to a subagent's ask arrives as a child input and is answered for it; a second answer, or any input once it ended, is refused. A nested subagent's call is in its parent subagent's chat. A subagent still running when the provider exits ends with it.",
  "spec": { "agent_id": "host-1", "created_at_ms": 1000 },
  "events": [
    { "fact": { "channel": "stream", "json": { "type": "ready" } } },
    { "input": { "id": "p1", "prompt": { "text": "survey the code" } } },
    { "fact": { "channel": "stream", "json": { "type": "user", "id": "u1", "text": "survey the code" } } },
    { "fact": { "channel": "stream", "json": { "type": "tool", "id": "call-1", "name": "Agent" } } },
    { "fact": { "channel": "stream", "json": { "type": "sub_start", "child": "c1", "call": "call-1", "title": "Survey the code" } },
      "expect": { "items": [] } },
    { "fact": { "channel": "stream", "json": { "type": "sub_text", "child": "c1", "id": "m1", "delta": "Look" } } },
    { "fact": { "channel": "stream", "json": { "type": "sub_text", "child": "c1", "id": "m1", "delta": "ing" } } },
    { "checkpoint": {} },
    { "fact": { "channel": "stream", "json": { "type": "sub_ask", "child": "c1", "id": "ask-1", "tool": "m1", "tool_name": "Bash" } },
      "note": "the ask is the subagent's own: the host does not need you",
      "expect": { "phase": "WORKING", "asks": [] } },
    { "child_input": { "child": "c1", "id": "a1", "answer": { "ask": "ask-1", "answer": { "allow": {} } } },
      "expect": { "reply": "accepted" } },
    { "child_input": { "child": "c1", "id": "a2", "answer": { "ask": "ask-1", "answer": { "allow": {} } } },
      "note": "a second client's answer to the same ask",
      "expect": { "reply": "rejected:CLOSED_ASK", "silent": true } },
    { "fact": { "channel": "stream", "json": { "type": "sub_start", "child": "c2", "by": "c1", "call": "m1", "title": "Read the tests" } } },
    { "fact": { "channel": "stream", "json": { "type": "sub_text_done", "child": "c1", "id": "m1" } } },
    { "fact": { "channel": "stream", "json": { "type": "sub_end", "child": "c2" } } },
    { "fact": { "channel": "stream", "json": { "type": "sub_end", "child": "c1" } } },
    { "child_input": { "child": "c1", "id": "a3", "answer": { "ask": "ask-1", "answer": { "allow": {} } } },
      "note": "an input to a subagent that ended",
      "expect": { "reply": "rejected:UNSUPPORTED", "silent": true } },
    { "fact": { "channel": "stream", "json": { "type": "tool_result", "id": "call-1", "output": "surveyed" } } },
    { "fact": { "channel": "stream", "json": { "type": "turn_end" } } },
    { "fact": { "channel": "stream", "json": { "type": "sub_start", "child": "c3", "call": "call-1", "title": "Continue the survey" } } },
    { "provider_exit": { "code": 0 },
      "note": "a subagent running when its provider exits ends with it" }
  ]
}
