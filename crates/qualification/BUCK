amux_rust_test(
    name = "integration",
    version = "0.1.0",
    deps = DEPS + TEST_DEPS,
    # Only the binaries its suites start: each is a link of its own, which
    # every change to a crate below this one would otherwise repeat.
    run_env = {
        "CARGO_BIN_EXE_acp-probe": "$(location :acp-probe)",
        "CARGO_BIN_EXE_claude-probe": "$(location :claude-probe)",
    },
    resources = ["//crates/interpret:fixtures"],
    binaries = True,
)

# The live lanes start a probe in front of the real provider, which they
# find beside amux and the fakes.
amux_binaries(
    name = "live-binaries",
    binaries = TEST_BINARIES | {
        "acp-probe": ":acp-probe",
        "claude-probe": ":claude-probe",
        "codex-probe": ":codex-probe",
    },
)
