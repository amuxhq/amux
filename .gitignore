# Generated by Cargo
# will have compiled files and executables
target

# SwiftPM build output from running a package's tests directly
.build/


docs/deployment.md
notes/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/

findings.jsonl
overnight_cleanup.py
.worktrees

# Unattended-flight state and its eventual local handoff proof are workspace
# artifacts, not source inputs.
.autopilot/
.handoff
.handoff/

# A performance run's own numbers — verdict, samples, cadence and the report
# written from them — land under target/ and are ignored with it: they belong
# to one run, and tracking them would make every run a diff. The recorded
# baselines under apps/apple/Perf/baselines are the opposite case and are tracked on
# purpose: an invisible baseline makes re-baselining the cheapest way to turn a
# red suite green, and nobody ever sees the number get worse. Do not add a rule
# that swallows them.

# Xcode and SwiftPM per-user state beside the generated iOS project
apps/apple/**/.swiftpm/
apps/apple/**/xcuserdata/

# Bytecode Python leaves beside the scripts it runs
__pycache__/

# The Team ID to build and sign a phone build under. This repository builds
# simulator-only and holds no signing identity, so whoever runs the
# sandbox-purchase or release recipe writes this file locally; a committed one
# would build somebody else's app under their team. docs/RELEASE.md holds its
# contract.
apps/apple/Signing.local.xcconfig

# Credentials that must never be committed: environment files, App Store
# Connect keys, certificates and their private keys, provisioning profiles.
.env
.env.*
*.p8
*.p12
*.pem
*.mobileprovision
