{
  "about": "An ask opens on a fact and closes on a fact; needs-you whenever one is open; an answer to a closed ask is rejected and writes nothing; ticks never close an ask.",
  "spec": { "created_at_ms": 1000 },
  "events": [
    { "fact": { "channel": "stream", "json": { "type": "ready" } }, "expect": { "phase": "IDLE" } },
    { "input": { "id": "p1", "prompt": { "text": "delete the build dir" } } },
    { "fact": { "channel": "stream", "json": { "type": "user", "id": "u1", "text": "delete the build dir" } } },
    { "fact": { "channel": "stream", "json": { "type": "tool", "id": "t1", "name": "Bash", "input": { "command": "rm -rf build" } } } },
    { "fact": { "channel": "stream", "json": { "type": "ask", "id": "a1", "tool": "t1", "tool_name": "Bash" } },
      "expect": { "phase": "NEEDS_YOU", "asks": ["a1"] } },
    { "tick": 600000, "note": "ten quiet minutes close nothing", "expect": { "phase": "NEEDS_YOU", "asks": ["a1"], "silent": true } },
    { "input": { "id": "p2", "prompt": { "text": "while asked" } },
      "note": "a prompt while an ask is open waits in the queue",
      "expect": { "reply": "queued", "queue": ["p2"] } },
    { "input": { "id": "ans1", "answer": { "ask": "a1", "answer": { "allow": {} } } },
      "expect": { "reply": "accepted", "phase": "WORKING", "asks": [], "effects": ["write \"{\\\"type\\\":\\\"answer\\\",\\\"ask\\\":\\\"a1\\\"}\"", "reply ans1 accepted"] } },
    { "input": { "id": "ans2", "answer": { "ask": "a1", "answer": { "deny": { "note": "no" } } } },
      "note": "the second client's answer to the same ask",
      "expect": { "reply": "rejected:CLOSED_ASK", "silent": true, "effects": ["reply ans2 rejected:CLOSED_ASK"] } },
    { "fact": { "channel": "stream", "json": { "type": "tool_result", "id": "t1", "output": "removed" } } },
    { "fact": { "channel": "stream", "json": { "type": "tool", "id": "t2", "name": "Write" } } },
    { "fact": { "channel": "stream", "json": { "type": "ask", "id": "a2", "tool": "t2", "tool_name": "Write" } },
      "expect": { "phase": "NEEDS_YOU", "asks": ["a2"] } },
    { "fact": { "channel": "stream", "json": { "type": "tool_result", "id": "t2", "output": "answered in the provider's own interface" } },
      "note": "a tool result is a closing fact",
      "expect": { "phase": "WORKING", "asks": [] } },
    { "fact": { "channel": "stream", "json": { "type": "turn_end" } },
      "expect": { "phase": "WORKING", "queue": [] } },
    { "fact": { "channel": "stream", "json": { "type": "user", "id": "u2", "text": "while asked" } } },
    { "fact": { "channel": "stream", "json": { "type": "tool", "id": "t3", "name": "Bash" } } },
    { "fact": { "channel": "stream", "json": { "type": "ask", "id": "a3", "tool": "t3", "tool_name": "Bash" } },
      "expect": { "phase": "NEEDS_YOU" } },
    { "provider_exit": { "code": 1 },
      "note": "a session end closes the ask with its outcome unknown",
      "expect": { "phase": "STARTING", "asks": [], "turn_end": false } },
    { "input": { "id": "ans3", "answer": { "ask": "a3", "answer": { "allow": {} } } },
      "expect": { "reply": "rejected:CLOSED_ASK", "silent": true } }
  ]
}
