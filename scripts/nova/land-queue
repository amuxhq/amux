#!/bin/sh
# The landing queue on nova: what the land-queue service runs, from a
# checkout of main (infra's run-from-main keeps it there).
#
# The inbox and the landing tree are where the infra repository's
# build_host role puts them. The tree is a clone of its own, beside the
# checkout this runs from, since a landing resets and cleans it. Each check
# runs inside the merge's own `nix develop`, so a landing that changes the
# toolchain is checked with the toolchain it brings.
set -eu
root=/var/lib/build/land
inbox=/var/lib/build/inbox.git
tree=$root/tree
here=$(cd "$(dirname "$0")/../.." && pwd)

if [ ! -d "$tree/.git" ]; then
    git clone --quiet "$(git -C "$here" remote get-url origin)" "$tree"
fi
exec python3 "$here/scripts/land_queue.py" serve --inbox "$inbox" --tree "$tree" --nix --self-update
