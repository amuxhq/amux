# Every text file is checked out with LF endings on every platform. Tests
# compare rendered output against committed goldens, fixtures and snapshots
# byte for byte, replay recordings and keymaps are hashed, and CI regenerates
# code and fails on any byte difference; Windows runners default to autocrlf,
# which would translate all of them.
* text=auto eol=lf

# The committed protobuf descriptor set is binary outright.
crates/wire/src/generated/*.bin binary
# So is a released build's profile, which an upgrade test opens as it shipped:
# a store or a journal that reads as text would have its line endings changed.
crates/node/tests/fixtures/upgrade/** binary
crates/wire/src/generated/*.rs linguist-generated=true
