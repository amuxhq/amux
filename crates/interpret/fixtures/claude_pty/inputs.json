{
  "about": "Every semantic input becomes an effect for the agent process to type through its keymap: prompts (queued while the provider starts or works, withdrawable), the permission-mode cycle, interrupt and clear. A prompt that turns out to be a local command ends without a turn. Agent messages go to the messaging socket.",
  "spec": {
    "created_at_ms": 1800000000000
  },
  "events": [
    {
      "input": {
        "id": "p1",
        "prompt": {
          "text": "first"
        }
      },
      "expect": {
        "reply": "queued",
        "queue": [
          "p1"
        ],
        "phase": "STARTING"
      }
    },
    {
      "fact": {
        "channel": "hook",
        "json": {
          "hook_event_name": "SessionStart",
          "source": "startup",
          "session_id": "s1",
          "transcript_path": "/t/s1.jsonl",
          "model": "claude-opus-5-5"
        }
      },
      "expect": {
        "queue": [],
        "phase": "WORKING",
        "effects": [
          "follow \"/t/s1.jsonl\"",
          "terminal prompt \"first\""
        ]
      }
    },
    {
      "fact": {
        "channel": "transcript",
        "json": {
          "type": "user",
          "uuid": "u1",
          "timestamp": "2027-01-15T08:00:00.010Z",
          "sessionId": "s1",
          "origin": {
            "kind": "human"
          },
          "promptSource": "typed",
          "message": {
            "role": "user",
            "content": "first"
          }
        }
      },
      "expect": {
        "items": [
          "u1"
        ]
      }
    },
    {
      "input": {
        "id": "p2",
        "prompt": {
          "text": "second"
        }
      },
      "expect": {
        "reply": "queued",
        "queue": [
          "p2"
        ]
      }
    },
    {
      "input": {
        "id": "w1",
        "withdraw": {
          "target": "p2"
        }
      },
      "expect": {
        "reply": "accepted",
        "queue": []
      }
    },
    {
      "input": {
        "id": "w2",
        "withdraw": {
          "target": "p2"
        }
      },
      "expect": {
        "reply": "rejected:not_queued",
        "silent": true
      }
    },
    {
      "input": {
        "id": "k1",
        "cycle_permission_mode": {}
      },
      "expect": {
        "reply": "accepted",
        "effects": [
          "terminal cycle permission mode",
          "reply k1 accepted"
        ]
      }
    },
    {
      "input": {
        "id": "i1",
        "interrupt": {}
      },
      "expect": {
        "reply": "accepted",
        "effects": [
          "terminal interrupt",
          "reply i1 accepted"
        ]
      }
    },
    {
      "fact": {
        "channel": "transcript",
        "json": {
          "type": "user",
          "uuid": "u2",
          "timestamp": "2027-01-15T08:00:00.020Z",
          "sessionId": "s1",
          "message": {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "[Request interrupted by user]"
              }
            ]
          }
        }
      },
      "expect": {
        "phase": "IDLE",
        "turn_end": {
          "turn_id": 1,
          "last_message_key": ""
        }
      }
    },
    {
      "input": {
        "id": "i2",
        "interrupt": {}
      },
      "expect": {
        "reply": "accepted",
        "effects": [
          "reply i2 accepted"
        ]
      }
    },
    {
      "input": {
        "id": "p3",
        "prompt": {
          "text": "/compact"
        }
      },
      "expect": {
        "reply": "accepted",
        "phase": "WORKING"
      }
    },
    {
      "fact": {
        "channel": "transcript",
        "json": {
          "type": "user",
          "uuid": "u3",
          "timestamp": "2027-01-15T08:00:00.030Z",
          "sessionId": "s1",
          "message": {
            "role": "user",
            "content": "/compact"
          }
        }
      },
      "expect": {
        "items": [
          "u3"
        ]
      },
      "note": "the reflection of a local command is its slash row"
    },
    {
      "fact": {
        "channel": "hook",
        "json": {
          "hook_event_name": "SessionStart",
          "source": "compact",
          "session_id": "s1",
          "transcript_path": "/t/s1.jsonl",
          "model": "claude-opus-5-5"
        }
      },
      "expect": {
        "items": [
          "boundary:2"
        ]
      }
    },
    {
      "fact": {
        "channel": "transcript",
        "json": {
          "type": "user",
          "uuid": "u4",
          "timestamp": "2027-01-15T08:00:00.040Z",
          "sessionId": "s1",
          "message": {
            "role": "user",
            "content": "<local-command-stdout>Compacted</local-command-stdout>"
          }
        }
      },
      "expect": {
        "items": [
          "u3"
        ],
        "phase": "IDLE",
        "turn_end": false
      }
    },
    {
      "input": {
        "id": "c1",
        "clear": {}
      },
      "expect": {
        "reply": "accepted",
        "effects": [
          "terminal clear",
          "reply c1 accepted"
        ]
      }
    },
    {
      "agent_message": {
        "envelope": "e1",
        "from": "reviewer",
        "text": "please look at the diff"
      },
      "expect": {
        "reply": "queued",
        "items": [
          "agent-message:6531"
        ],
        "effects": [
          "inject e1 via MessagingSocket",
          "reply e1 queued"
        ]
      }
    },
    {
      "fact": {
        "channel": "transcript",
        "json": {
          "type": "user",
          "uuid": "u5",
          "timestamp": "2027-01-15T08:00:00.050Z",
          "sessionId": "s1",
          "isMeta": true,
          "message": {
            "role": "user",
            "content": "Another Claude session sent a message:\n<cross-session-message from=\"amux\" from-name=\"reviewer\">\nplease look at the diff\n</cross-session-message>"
          }
        }
      },
      "expect": {
        "silent": false,
        "phase": "WORKING",
        "items": []
      },
      "note": "Claude shows the message to the model: it is consumed, and answering it is a turn"
    },
    {
      "fact": {
        "channel": "transcript",
        "json": {
          "type": "assistant",
          "uuid": "a5",
          "timestamp": "2027-01-15T08:00:00.060Z",
          "sessionId": "s1",
          "message": {
            "id": "m5",
            "role": "assistant",
            "model": "claude-opus-5-5",
            "content": [
              {
                "type": "text",
                "text": "Looking."
              }
            ]
          }
        }
      },
      "expect": {
        "items": [
          "a5"
        ]
      }
    },
    {
      "agent_message": {
        "envelope": "e2",
        "from": "reviewer",
        "text": "and the tests"
      },
      "expect": {
        "reply": "queued"
      }
    },
    {
      "fact": {
        "channel": "transcript",
        "json": {
          "type": "user",
          "uuid": "u6",
          "timestamp": "2027-01-15T08:00:00.061Z",
          "sessionId": "s1",
          "isMeta": true,
          "origin": {
            "kind": "peer"
          },
          "message": {
            "role": "user",
            "content": "Another Claude session sent a message:\nand the tests\n\nThis came from another Claude session \u2014 not typed by your user."
          }
        }
      },
      "expect": {
        "items": []
      },
      "note": "the same, as Claude 2.1.282 words it"
    },
    {
      "fact": {
        "channel": "transcript",
        "json": {
          "type": "system",
          "uuid": "d5",
          "timestamp": "2027-01-15T08:00:00.070Z",
          "sessionId": "s1",
          "subtype": "turn_duration",
          "durationMs": 20
        }
      },
      "expect": {
        "turn_end": {
          "turn_id": 3,
          "last_message_key": "a5"
        },
        "phase": "IDLE"
      }
    }
  ]
}
