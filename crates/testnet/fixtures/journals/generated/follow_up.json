{
  "about": "A second prompt arrives while the first turn works: it waits in the queue, is submitted at the turn's end and runs as the next turn.",
  "spec": { "created_at_ms": 1000 },
  "events": [
    { "fact": { "channel": "stream", "json": { "type": "ready" } } },
    { "input": { "id": "p1", "prompt": { "text": "run the tests" } } },
    { "fact": { "channel": "stream", "json": { "type": "user", "id": "u1", "text": "run the tests" } } },
    { "input": { "id": "p2", "prompt": { "text": "then fix the first failure" } } },
    { "fact": { "channel": "stream", "json": { "type": "text", "id": "m1", "delta": "One test fails." } } },
    { "fact": { "channel": "stream", "json": { "type": "text_done", "id": "m1" } } },
    { "tick": 3000 },
    { "fact": { "channel": "stream", "json": { "type": "turn_end" } } },
    { "fact": { "channel": "stream", "json": { "type": "user", "id": "u2", "text": "then fix the first failure" } } },
    { "fact": { "channel": "stream", "json": { "type": "text", "id": "m2", "delta": "Fixed." } } },
    { "fact": { "channel": "stream", "json": { "type": "text_done", "id": "m2" } } },
    { "tick": 5000 },
    { "fact": { "channel": "stream", "json": { "type": "turn_end" } } }
  ]
}
