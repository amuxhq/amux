# The iPhone app's recipes. `just ios <recipe>` from anywhere in the checkout;
# every recipe runs from the repository root so paths mean the same thing in
# the scripts, the Xcode project and the Rust workspace.
#
# Recipes that touch a device run under `scripts/with iphone`, and those that
# may need the small one under `scripts/with iphone iphone-small`: inside a
# wt worktree that leases a device of each kind for the command, so two
# checkouts never drive one device at once; elsewhere it runs the command
# directly and the scripts use the first device of the same names.

set shell := ["sh", "-cu"]
set positional-arguments
set working-directory := "../.."

# Wall-clock bound for every recipe; portable where GNU timeout is absent.
bounded := "scripts/bounded"

# The interpreter these scripts are written to, chosen rather than assumed;
# scripts/py explains why and picks it.
python := "scripts/py"
buck2 := "scripts/buck2"

# List the iPhone app's recipes.
default:
    @just --list ios

# The Rust tools the phone recipes drive: the screenshot comparator and the
# served test network the journeys connect a simulator to with the amux and
# fake providers its machines run. One cargo invocation builds them all, so the
# served net runs binaries whose features match its own and builds nothing
# itself.
# Build the Rust tools the phone recipes drive.
tools:
    {{bounded}} 900 cargo build --locked -p ios-tools -p testnet -p qualification -p amux -p provider-fakes --bins

# The rules the screens package is written to: SwiftUI only outside a
# registered leaf, no platform conditionals, no spinners. Pure text, so it runs
# before anything is compiled and says which line is wrong. Then the generated
# Swift mirror against the Rust it mirrors: premerge runs this recipe and
# nothing else of the Apple side's, so a stale mirror would otherwise pass.
# Check the Swift sources against the screens package's writing rules.
lint:
    {{bounded}} 300 sh -c 'sh apps/apple/Tools/feature-lint.sh && sh apps/apple/Tools/test-waits-lint.sh && apps/apple/Tools/strings-lint.sh'
    {{bounded}} 300 {{buck2}} run //crates/ios-tools:ios-tools-bin -- swift-types --check

# Prove the bridge graph carries no provider, agent host or test
# infrastructure onto the phone. The driving tools are the one deliberate
# exception and are checked separately with them enabled.
# Prove the bridge graph carries no provider, host or test crate.
graph-check:
    mkdir -p target/ios
    {{bounded}} 300 cargo tree --locked -p app-ffi --target aarch64-apple-ios-sim -e normal --prefix none --format "{p}" > target/ios/graph-shipping.txt
    ! grep -E "^(pty-host|agent|interpret|claude-protocol|codex-protocol|schemars|testnet|qualification|replay-support) v" target/ios/graph-shipping.txt
    {{bounded}} 300 cargo tree --locked -p app-ffi --features debug-tools --target aarch64-apple-ios-sim -e normal --prefix none --format "{p}" > target/ios/graph-driving.txt
    ! grep -E "^(pty-host|agent|interpret|claude-protocol|codex-protocol|schemars) v" target/ios/graph-driving.txt

# The pinned devices every capture and measurement runs on. Creating them is
# idempotent; they are left booted because every later recipe needs them up.
#
# The bound here is a backstop, not the budget. A runner that has never seen
# these devices creates both and boots each of them twice — once to make the
# device, once more so SpringBoard reads the pinned region it was created
# without — and a cold machine has taken eleven minutes over that. What
# catches a simulator that is genuinely stuck is the per-boot timeout inside
# the script, which names the device and the step it hung on; an outer bound
# tight enough to fire first only reports that something took a while.
# Create and boot the pinned simulators. Names one or both kinds: golden, small.
simulator *NAMES:
    scripts/with iphone iphone-small -- {{bounded}} 3600 {{python}} -B apps/apple/Tools/ios_simulators.py {{NAMES}}

# Buck2 builds the app (apps/apple/BUCK), bridge and all, and it is copied
# to target/ios/Debug-iphonesimulator/Amux.app, where every recipe that
# installs it looks. `--configuration measured` builds the optimised app,
# `--device` builds for a phone and signs it for development.
# Build the debug app.
build *ARGS:
    if [ "${1-}" = -- ]; then shift; fi; {{bounded}} 3600 {{python}} -B apps/apple/Tools/ios-build.py "$@"

# The app and every iPhone test target, built without running any.
# Build the app and every unit suite once.
test-build:
    {{bounded}} 3600 {{python}} -B apps/apple/Tools/ios-build.py --tests

# The package suites and the app-hosted suite, as Buck2 tests: each leases a
# simulator from wt's pool inside its own action, and a passing result is
# cached, so a second tree's run of the same inputs is a hit. Arguments are
# Buck2's (a target names one suite: `just ios unit
# //apps/apple/Packages/AmuxCore:AmuxCoreTests`).
# Run the package and app-hosted unit suites on a leased simulator.
unit *ARGS:
    if [ "${1-}" = -- ]; then shift; fi; \
    if [ $# -eq 0 ]; then set -- //apps/apple/Packages/AmuxCore:AmuxCoreTests //apps/apple/Packages/AmuxDesign:AmuxDesignTests //apps/apple/Packages/AmuxFeatures:AmuxFeaturesTests //apps/apple/Packages/AmuxPush:AmuxPushTests //apps/apple/Packages/AmuxShell:AmuxShellTests //apps/apple/Packages/AmuxTestSupport:AmuxTestSupportTests //apps/apple:AmuxAppTests; fi; \
    {{bounded}} 3600 {{buck2}} test "$@"

# The app driven the way a person drives it, against a real relay and real
# daemons started from a committed topology. No arguments runs every journey
# journeys/manifest.json declares.
# Drive the app like a person against real daemons and a real relay.
journey *ARGS: build tools
    if [ "${1-}" = -- ]; then shift; fi; scripts/with iphone -- {{bounded}} 2400 target/debug/testnet journey phone "$@"

# Sweep every state this build draws and require each control on it to have a
# name VoiceOver can read and at least 44 pt to hit. A UI test, because that is
# the only accessibility client an app cannot be for itself.
# Audit every drawn state for VoiceOver names and 44 pt targets.
accessibility: test-build tools
    scripts/with iphone -- {{bounded}} 2400 target/debug/testnet journey accessibility

# The optimised app on the enrolled Mac's simulator against the served
# performance network: cold launch, store read, reconciliation at 0 and
# 100 ms and through the relay with every way to it gated at 100 ms,
# streaming and idle; budgets and drift per docs/PERFORMANCE.md.
# `--baseline` records this machine's medians; `--only GROUP` takes one
# group; `--describe` says what would run without running it.
# `--device` runs it on the phone plugged into this Mac instead, over its
# USB link: the bridge and the app are built for the phone and signed with
# the local signing file's Team ID, and no simulator is leased.
# Measure the phone.
perf *ARGS: tools
    if [ "${1-}" = -- ]; then shift; fi; \
    device=; for argument in "$@"; do [ "$argument" = --device ] && device=--device; done; \
    {{bounded}} 3600 {{python}} -B apps/apple/Tools/ios-build.py --configuration measured $device && \
    if [ -n "$device" ]; then {{bounded}} 3600 target/debug/testnet journey perf "$@"; \
    else scripts/with iphone -- {{bounded}} 3600 target/debug/testnet journey perf "$@"; fi

# The same run on the phone plugged into this Mac, with the first sample of
# GROUP (cold, reconciliation, streaming or idle) recorded under the named
# Instruments template (`xcrun xctrace list templates`: Time Profiler, App
# Launch, Animation Hitches, SwiftUI, Swift Concurrency, Allocations, Power
# Profiler, ...). The trace and its tables, exported as XML, land in
# target/ios/traces/.
# Profile one part of the phone run on the plugged-in phone.
profile GROUP TEMPLATE="Time Profiler": tools
    mkdir -p target/ios/traces; \
    trace="target/ios/traces/$1-$(printf %s "$2" | tr ' A-Z' '-a-z')-$(date +%Y%m%d-%H%M%S).trace"; \
    {{bounded}} 3600 {{python}} -B apps/apple/Tools/ios-build.py --configuration measured --device && \
    {{bounded}} 3600 target/debug/testnet journey perf --device --only "$1" \
        --trace "$trace" --template "$2" --during "$1"

# Builds the shipping app for the simulator with Buck2 and inspects it for
# excluded platforms and debug-only surfaces; `--app PATH` audits an app
# already built, as a release does the one it signed.
# Inspect the release bundle for debug surfaces and excluded platforms.
scope-audit *ARGS:
    if [ "${1-}" = -- ]; then shift; fi; {{bounded}} 3600 {{python}} -B apps/apple/Tools/ios-scope-audit.py "$@"

# Everything a change to the app is held to, in dependency order, stopping at
# the first failure: formatting, lint and tests of the Rust workspace, then
# the phone's lint, graphs, build, units, journeys, accessibility, measured
# run and shipped-scope audit.
# Run everything a change to the app is held to, in order.
verify:
    {{bounded}} 12600 cargo run --locked -q -p ios-tools -- verify

# The half of verification that building the app can settle: lints, graphs,
# the app and every suite built, and the unit suites run. Nothing
# here drives a running app against served machines, which is what keeps it
# quick enough to gate a push.
# Run the half of verification a build can settle.
gate:
    {{bounded}} 12600 cargo run --locked -q -p ios-tools -- verify --gate

# The half that drives a running app and judges what it drew: the store suite
# on the simulator, journeys and the accessibility audit. Slow.
# Run the half that drives a running app.
captures:
    {{bounded}} 12600 cargo run --locked -q -p ios-tools -- verify --captures

# What the shipping bundle is held to. `release` depends on both of these, so
# cutting a release runs them whether or not anybody ran this.
# Build the shipping bundle and audit what it contains.
shipping:
    {{bounded}} 12600 cargo run --locked -q -p ios-tools -- verify --shipping

# `just ios perf` under the verifier, so the whole run and this stage report
# the same way.
# The phone measured on this Mac.
measured:
    {{bounded}} 12600 cargo run --locked -q -p ios-tools -- verify --measured

# The unit tests of the phone's recipe scripts. Pure Python; nothing is
# built or booted.
# Run the phone's recipe scripts' own unit tests.
script-tests:
    {{bounded}} 120 {{python}} -m unittest discover -s apps/apple/Tools/tests -p '*_test.py' -t apps/apple/Tools/tests

# Version, build, sign, audit, validate and upload the iPhone app, then
# commit and tag the numbers and push both (--no-upload and --no-push stop
# short). --preflight reports its inputs and stops; --rehearse builds, signs
# and validates the would-be release without writing the tree or cutting a
# tag. The scope audit runs on the signed bundle before Apple sees it, so
# nothing carrying a debug surface or an excluded platform is ever uploaded.
# docs/RELEASE.md holds the contract, including the one-time App Store Connect
# setup behind it.
# Version, build, sign and upload the app, then push the tag.
release *ARGS:
    if [ "${1-}" = -- ]; then shift; fi; {{bounded}} 8100 {{python}} -B scripts/release.py "$@"

# `just ios deploy 1.0.34` submits the version's released build for review,
# released once approved with no phased release; `--channel preview` gives it
# to the external TestFlight group instead. `--notes-file PATH` sets What's
# New (or What to Test); `--dry-run` says what would change and changes
# nothing (docs/RELEASE.md).
# Put a released build in front of people.
deploy VERSION *ARGS:
    shift; if [ "${1-}" = -- ]; then shift; fi; {{bounded}} 600 {{python}} -B apps/apple/Tools/ios-deploy.py {{VERSION}} "$@"

# Replaces the iPhone screenshots of the App Store version being prepared
# with the seven frames `just store` composes, in order, through the App Store
# Connect API and the release key. --dry-run says what would change and
# changes nothing; --version X.Y.Z names the version, created if it is new.
# Never attaches a build or submits for review (docs/RELEASE.md).
# Put the App Store's screenshots on the version being prepared.
screenshots *ARGS:
    if [ "${1-}" = -- ]; then shift; fi; {{bounded}} 900 {{python}} -B apps/apple/Tools/ios-screenshots.py "$@"

# Signs a QA account into the real amux.sh from this Mac, with no app, the
# same way the phone does, and reports what that account is entitled to and
# whether the relay will issue it a credential. Evidence a person runs by
# hand, never a test and never in CI: it reaches the production account
# service and needs a password from the credential command. Deliberately
# absent from the verification list in crates/ios-tools/src/ios_verify.rs.
# Sign a QA account into the real amux.sh from this Mac (by hand only).
qa-cloud-signin:
    {{bounded}} 300 {{python}} -B scripts/qa-cloud-signin.py

# Carries a real App Store sandbox purchase from a physical phone to the
# account service and reads back what the account may then do. A sandbox
# transaction exists only on a phone signed into a sandbox Apple Account
# running a development-signed build, so this never runs on a simulator and
# never invents one; `--preflight` reports what is present and missing on this
# Mac without touching StoreKit, the store or amux.sh. Evidence a person runs
# by hand, never a test and never in CI, and deliberately absent from the
# verification list in crates/ios-tools/src/ios_verify.rs.
# Carry a real sandbox purchase from a phone to the account service (by hand only).
qa-sandbox-purchase *ARGS:
    if [ "${1-}" = -- ]; then shift; fi; {{bounded}} 3600 {{python}} -B scripts/qa-sandbox-purchase.py "$@"

