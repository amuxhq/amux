# The browser extension's recipes. `just browser <recipe>` from anywhere in
# the checkout; every recipe runs from the repository root. docs/BROWSER.md
# describes the extension, docs/RELEASE.md its release.

set shell := ["sh", "-cu"]
set positional-arguments
set working-directory := "../.."

bounded := "scripts/bounded"
python := "scripts/py"
just := just_executable()

# List the browser extension's recipes.
default:
    @just --list browser

# browser-core as WebAssembly, then the extension around it, into
# js/extension/dist. `--dev` builds js/extension/dist-dev instead, the copy a
# development tree loads unpacked, which starts `just browser dev-host`'s
# host rather than an installed amux.
# Build the browser extension.
build *ARGS:
    wasm=$({{bounded}} 900 scripts/built '//crates/browser-core:browser-core[shared]' --target-platforms root//build/platforms:wasm-app-shipping-wasm) && AMUX_BROWSER_CORE=$wasm \
    {{bounded}} 300 sh -c 'cd js && { [ "${AMUX_NPM_READY-}" = 1 ] || npm ci --no-audit --no-fund --loglevel=error; } && cd extension && node build.ts "$@"' sh "$@"

# Biome, the types, the unit tests, and the end-to-end test in Chromium
# against amux and the fake providers, as Buck2 tests (js/BUCK): only those
# whose files changed run. The end-to-end test runs on a Linux worker, whose
# toolchain has the browser, and is skipped, and named, when none is in reach.
# Check and test the overlay and the extension.
test:
    {{bounded}} 1800 {{just}} test //js:

# CI's twin of `test`, building the WebAssembly and the binaries with Cargo.
# Check and test the extension on Cargo's build, as CI does.
cargo-test:
    {{bounded}} 900 cargo build --locked -p browser-core --target wasm32-unknown-unknown --profile wasm
    {{bounded}} 300 sh -c 'cd js && { [ "${AMUX_NPM_READY-}" = 1 ] || npm ci --no-audit --no-fund --loglevel=error; } && cd extension && node build.ts --dev'
    {{bounded}} 900 cargo build --locked -p amux -p provider-fakes --bins
    {{bounded}} 600 sh -c 'cd js && npm run check && npx vitest run && { [ "${AMUX_PLAYWRIGHT_READY-}" = 1 ] || npx playwright install chromium >/dev/null; } && npx playwright test'

# Biome's format and lint, the types, and the unit tests, without building,
# as Buck2 tests (js/BUCK); `just premerge` runs them with every other test.
# The JavaScript's fast checks.
check:
    {{bounded}} 600 {{just}} test //js:biome //js:types //js:unit

# Format and fix the JavaScript under js/ with Biome.
fmt:
    {{bounded}} 300 sh -c 'cd js && npm ci --no-audit --no-fund --loglevel=error && npm run fmt'

# The overlay's modes and the side panel's states, light and dark, into
# js/tour, with the Chrome Web Store's screenshots and promo tile.
# Screenshot every surface the extension draws.
tour: (build "--dev")
    binaries=$({{bounded}} 900 scripts/built //crates/provider-fakes:binaries) && TESTNET_BINARIES=$binaries \
    {{bounded}} 600 sh -c 'cd js && rm -rf tour && npx playwright install chromium >/dev/null && AMUX_TOUR=1 npx playwright test tour'

# Registers the `sh.amux.browser.dev` host with every installed Chromium
# browser, running this tree's built amux with the config in AMUX_CONFIG
# now. `just browser dev-host remove` takes it out again.
# Let this tree's development extension reach this tree's amux.
dev-host *ARGS:
    {{bounded}} 60 scripts/browser-dev-host.sh "$@"

# `just browser release 0.2.0` sets the manifest's version, builds, zips,
# commits, tags browser-v0.2.0, pushes, and keeps the zip as that tag's
# GitHub Release asset.
# Cut a release of the browser extension.
release VERSION:
    JUST={{just_executable()}} {{bounded}} 1800 {{python}} -B scripts/browser_release.py release {{VERSION}}

# `just browser deploy 0.2.0` uploads the release's zip to the Chrome Web
# Store and submits it for review, published once approved. `--staged` holds
# it after approval until `deploy 0.2.0` again publishes it; `--dry-run`
# says what would happen and changes nothing.
# Put a released version on the Chrome Web Store.
deploy VERSION *ARGS:
    shift; if [ "${1-}" = -- ]; then shift; fi; {{bounded}} 900 {{python}} -B scripts/browser_release.py deploy {{VERSION}} "$@"

# Show what the Chrome Web Store holds: the published and submitted versions.
status:
    {{bounded}} 120 {{python}} -B scripts/browser_release.py status
