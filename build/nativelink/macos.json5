// NativeLink on CI's macOS runners (docs/CI.md, "The macOS jobs"): the
// action cache Buck2 reads and writes, a CAS in front of the build host's,
// and a worker that runs the tests. scripts/nativelink.py `macos` fills in
// the {{...}} values and runs it.
//
// Buck2 runs the build actions itself (AMUX_BUILD_HERE, scripts/buck-config.py):
// on this worker each action's inputs were staged from the build host's CAS
// across the internet, which cost more than the compiling did. Tests still
// run here, so their results are cached. Outputs go to the build host's CAS
// as well as this machine's, and the action cache is this machine's
// (LOCAL_AC): the build host's can't be written from here, so the results
// are kept in GitHub's cache between runs, as the Windows job keeps its
// tests'. A result whose outputs the build host has evicted is reported
// missing and the action runs again.
{
  stores: [
    {
      name: "REMOTE_CAS",
      grpc: {
        instance_name: "main",
        endpoints: [{ address: "{{remote}}" }],
        store_type: "cas",
        connections_per_endpoint: 4,
        max_concurrent_requests: 64,
        retry: { max_retries: 6, delay: 0.25, jitter: 0.5 },
      },
    },
    {
      name: "LOCAL_CAS",
      filesystem: {
        content_path: "{{cache}}/cas",
        temp_path: "{{cache}}/cas-tmp",
        eviction_policy: { max_bytes: {{cas_bytes}} },
      },
    },
    {
      // Uploads go to both; reads fill the local layer from the build
      // host. The worker uses the same, so a test's outputs reach the
      // build host too.
      name: "CAS",
      fast_slow: {
        fast: { ref_store: { name: "LOCAL_CAS" } },
        slow: { ref_store: { name: "REMOTE_CAS" } },
      },
    },
    {
      // The results of every action, the ones Buck2 ran and uploaded and
      // the tests this worker ran, kept between runs. One whose outputs the
      // build host has evicted is reported missing, and the action runs.
      name: "LOCAL_AC",
      completeness_checking: {
        backend: {
          filesystem: {
            content_path: "{{results}}",
            temp_path: "{{cache}}/ac-tmp",
            eviction_policy: { max_bytes: {{ac_bytes}} },
          },
        },
        cas_store: { ref_store: { name: "CAS" } },
      },
    },
    // No layer of the build host's action cache: nothing writes a macOS
    // result there (its own worker is Linux, and neither a Mac nor a
    // runner writes it), so every lookup in it was a miss that cost a
    // round trip across the internet.
  ],
  schedulers: [
    {
      name: "SCHEDULER",
      simple: {
        supported_platform_properties: {
          OSFamily: "exact",
          cpu_count: "minimum",
          memory_kb: "minimum",
          // Carried only so an Xcode upgrade changes every Mac action's key.
          xcode: "ignore",
        },
      },
    },
  ],
  workers: [
    {
      local: {
        name: "macos-",
        worker_api_endpoint: { uri: "grpc://127.0.0.1:50061" },
        cas_fast_slow_store: "CAS",
        upload_action_result: { ac_store: "LOCAL_AC" },
        work_directory: "{{cache}}/work",
        max_action_timeout_s: 3600,
        // Only a modern python3, tmux and the operating system's own tools
        // are on PATH, as on a developer's Mac (build/nativelink/mac.json5).
        additional_environment: {
          PATH: { value: "{{path}}" },
        },
        platform_properties: {
          OSFamily: { values: ["macos"] },
          cpu_count: { values: ["{{cores}}"] },
          memory_kb: { values: ["{{memory_kb}}"] },
        },
      },
    },
  ],
  servers: [
    {
      name: "clients",
      listener: { http: { socket_address: "127.0.0.1:50051" } },
      services: {
        cas: [{ instance_name: "main", cas_store: "CAS" }],
        ac: [{ instance_name: "main", ac_store: "LOCAL_AC" }],
        execution: [{ instance_name: "main", cas_store: "CAS", scheduler: "SCHEDULER" }],
        capabilities: [{ instance_name: "main", remote_execution: { scheduler: "SCHEDULER" } }],
        bytestream: [{ instance_name: "main", cas_store: "CAS" }],
      },
    },
    {
      name: "workers",
      listener: { http: { socket_address: "127.0.0.1:50061" } },
      services: {
        worker_api: { scheduler: "SCHEDULER" },
        health: {},
      },
    },
  ],
}
