# Target platforms (what an output is for) and the execution platform (where
# Buck2 sends an action). docs/BUILD.md, "Configurations", says how a target
# picks its platform.
load(":defs.bzl", "MODES", "TARGETS", "execution_platform", "execution_platforms", "target_platform")

# One target platform per target, product, purpose and mode, named
# `<target>-<product>-<purpose>-<mode>`: `macos-cli-shipping-dev` is a
# development build of the desktop product for this Mac.
[
    target_platform(
        name = "{}-{}-{}-{}".format(target, product, purpose, mode),
        constraints = constraints + [
            "root//build/constraints:" + product,
            "root//build/constraints:" + purpose,
            "root//build/constraints:" + mode,
        ],
        visibility = ["PUBLIC"],
    )
    for target, constraints in TARGETS.items()
    for product in ["cli", "app"]
    for purpose in ["shipping", "testing"]
    for mode in MODES
]

# Build scripts, proc macros and code generators run on an execution
# platform, so they are built as tools: a development build, with test
# features on.
TOOL_CONSTRAINTS = [
    "root//build/constraints:cli",
    "root//build/constraints:testing",
    "root//build/constraints:dev",
]

execution_platform(
    name = "exec-macos",
    constraints = ["prelude//os:macos", "prelude//cpu:arm64"] + TOOL_CONSTRAINTS,
    properties = {
        "OSFamily": "macos",
        "cpu_count": "1",
        # Xcode isn't named by a versioned path, so its version goes into
        # every action's key here (scripts/buck-config.py).
        "xcode": read_root_config("apple", "xcode", ""),
    },
)

execution_platform(
    name = "exec-linux",
    constraints = ["prelude//os:linux", "prelude//cpu:x86_64"] + TOOL_CONSTRAINTS,
    properties = {
        "OSFamily": "linux",
        "cpu_count": "1",
    },
)

# A Mac prefers its own worker and sends what only Linux can run to nova's;
# nova has no macOS worker to send anything to.
execution_platforms(
    name = "execution",
    platforms = [":exec-macos", ":exec-linux"] if host_info().os.is_macos else [":exec-linux"],
)
