# The live lanes, which Cargo builds only with `--features live`: the
# `live` label keeps them out of `just test`, and `just live` runs them.
amux_rust_test(
    name = "claude_pty_live",
    version = "0.1.0",
    deps = DEPS + TEST_DEPS,
    run_env = {
        "TESTNET_BINARIES": "$(location :live-binaries)",
        "CARGO_BIN_EXE_acp-probe": "$(location :acp-probe)",
        "CARGO_BIN_EXE_claude-probe": "$(location :claude-probe)",
        "CARGO_BIN_EXE_codex-probe": "$(location :codex-probe)",
        "CARGO_BIN_EXE_perf": "$(location :perf)",
        "CARGO_BIN_EXE_perf-topology": "$(location :perf-topology)",
        "CARGO_BIN_EXE_relay-curve": "$(location :relay-curve)",
    },
    labels = ["live"],
    harness = False,
    resources = ["//crates/interpret:fixtures"],
)

