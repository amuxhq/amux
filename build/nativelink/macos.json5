// NativeLink on CI's macOS runners (docs/CI.md, "The macOS jobs"): the
// cache Buck2 reads and writes, and a worker that runs the tests.
// scripts/nativelink.py `macos` fills in the {{...}} values and runs it.
//
// Buck2 runs the build actions itself (AMUX_BUILD_HERE, scripts/buck-config.py)
// and the worker runs the tests, so their results are cached too. Both
// stores are on the runner's disk, and the job keeps them in GitHub's cache
// between runs. The build host isn't used: it can't run a Mac's actions,
// and it is ~100 ms from GitHub's runners, so staging an action's inputs
// from its CAS cost ~4 s an action and uploading a 190 MB test binary to
// it five minutes. The CAS's size is capped so every job's store fits in
// GitHub's 10 GB for the repository; past it the least recently used
// blobs go, and an action whose outputs went runs again.
{
  stores: [
    {
      name: "LOCAL_CAS",
      filesystem: {
        content_path: "{{cache}}/cas",
        temp_path: "{{cache}}/cas-tmp",
        eviction_policy: { max_bytes: {{cas_bytes}} },
      },
    },
    {
      // The worker's store must be a fast_slow one; nothing is behind it.
      name: "CAS",
      fast_slow: {
        fast: { ref_store: { name: "LOCAL_CAS" } },
        slow: { noop: {} },
      },
    },
    {
      // The results of every action, the ones Buck2 ran and uploaded and
      // the tests the worker ran. One whose outputs the CAS has evicted is
      // reported missing, and the action runs.
      name: "LOCAL_AC",
      completeness_checking: {
        backend: {
          filesystem: {
            content_path: "{{cache}}/ac",
            temp_path: "{{cache}}/ac-tmp",
            eviction_policy: { max_bytes: {{ac_bytes}} },
          },
        },
        cas_store: { ref_store: { name: "LOCAL_CAS" } },
      },
    },
  ],
  schedulers: [
    {
      name: "SCHEDULER",
      simple: {
        supported_platform_properties: {
          OSFamily: "exact",
          cpu_count: "minimum",
          memory_kb: "minimum",
          // Carried only so an Xcode upgrade changes every Mac action's key.
          xcode: "ignore",
        },
      },
    },
  ],
  workers: [
    {
      local: {
        name: "macos-",
        worker_api_endpoint: { uri: "grpc://127.0.0.1:50061" },
        cas_fast_slow_store: "CAS",
        upload_action_result: { ac_store: "LOCAL_AC" },
        work_directory: "{{cache}}/work",
        max_action_timeout_s: 3600,
        // Only a modern python3, tmux and the operating system's own tools
        // are on PATH, as on a developer's Mac (build/nativelink/mac.json5).
        // What follows PATH is what the job hands every test about this
        // runner (scripts/nativelink.py's FORWARDED), outside any action's key.
        additional_environment: {
          PATH: { value: "{{path}}" },
          {{forwarded}}
        },
        platform_properties: {
          OSFamily: { values: ["macos"] },
          cpu_count: { values: ["{{cores}}"] },
          memory_kb: { values: ["{{memory_kb}}"] },
        },
      },
    },
  ],
  servers: [
    {
      name: "clients",
      listener: { http: { socket_address: "127.0.0.1:50051" } },
      services: {
        cas: [{ instance_name: "main", cas_store: "CAS" }],
        ac: [{ instance_name: "main", ac_store: "LOCAL_AC" }],
        execution: [{ instance_name: "main", cas_store: "CAS", scheduler: "SCHEDULER" }],
        capabilities: [{ instance_name: "main", remote_execution: { scheduler: "SCHEDULER" } }],
        bytestream: [{ instance_name: "main", cas_store: "CAS" }],
      },
    },
    {
      name: "workers",
      listener: { http: { socket_address: "127.0.0.1:50061" } },
      services: {
        worker_api: { scheduler: "SCHEDULER" },
        health: {},
      },
    },
  ],
}
