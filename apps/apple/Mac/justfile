# The Mac app's recipes. `just mac <recipe>` from anywhere in the checkout;
# every recipe runs from the repository root, as the iPhone app's do.

set shell := ["sh", "-cu"]
set positional-arguments
set working-directory := "../../.."

bounded := "scripts/bounded"
python := "scripts/py"
derived := "target/mac/DerivedData"
app := "target/mac/DerivedData/Build/Products/Debug/Amux.app"

# List the Mac app's recipes.
default:
    @just --list mac

# The bridge's Mac slice, added to the framework the Swift packages link.
# Build the bridge with its Mac slice.
rust:
    {{bounded}} 1800 {{python}} -B apps/apple/Tools/ios-rust.py --mac

# The app, with the checkout's own amux inside it, from a project generated
# from apps/apple/Mac/project.yml.
# Build the Mac app.
build: rust
    {{bounded}} 900 cargo build --locked -p amux --bin amux
    {{bounded}} 300 sh -c 'cd apps/apple/Mac && xcodegen generate --spec project.yml --quiet'
    {{bounded}} 1200 xcodebuild -project apps/apple/Mac/AmuxMac.xcodeproj -scheme AmuxMac \
        -configuration Debug -destination 'platform=macOS,arch=arm64' \
        -derivedDataPath {{derived}} -quiet build

# Walks setting up through the app's own model against a scratch daemon and
# draws every screen and the Settings window into target/mac-onboarding/,
# light and dark. The screens are drawn into windows never put on screen, in
# the test runner rather than the app, so nothing shows on the desktop.
# Draw the Mac app's setting-up screens offscreen.
shots: rust
    {{bounded}} 900 cargo build --locked -p amux --bin amux
    {{bounded}} 300 sh -c 'cd apps/apple/Mac && xcodegen generate --spec project.yml --quiet'
    {{bounded}} 1200 xcodebuild -project apps/apple/Mac/AmuxMac.xcodeproj -scheme AmuxMac \
        -destination 'platform=macOS,arch=arm64' -derivedDataPath {{derived}} -quiet test

# Runs the built app in the foreground against this checkout's installation
# (AMUX_CONFIG, as wt sets it), starting the checkout's daemon first so the
# app attaches rather than installs.
# Build and run the Mac app against this checkout's amux.
run: build
    {{bounded}} 60 sh -c 'target/debug/amux status >/dev/null 2>&1 || target/debug/amux server start'
    {{app}}/Contents/MacOS/Amux

# `just mac release 0.0.1` builds the app with the shipping bridge, signs it
# with Developer ID, makes the update zip and the notarized disk image,
# commits the version, tags mac-v0.0.1, pushes and puts both on the tag's
# GitHub Release. `--rehearse` builds and signs everything and writes, tags
# and uploads nothing; `--no-notarize` skips Apple (docs/RELEASE.md).
# Cut a release of the Mac app.
release VERSION *ARGS:
    shift; if [ "${1-}" = -- ]; then shift; fi; {{bounded}} 7200 cargo run --locked -q -p xtask -- mac release {{VERSION}} "$@"

# `just mac deploy 0.0.1` signs the stable channel's Mac feed over the
# release's zip and publishes it, with the disk image as Amux.dmg;
# `--channel preview` publishes the preview feed instead, and `--key-file
# PATH` signs with the backup key.
# Put a released Mac app in front of a channel.
deploy VERSION *ARGS:
    shift; if [ "${1-}" = -- ]; then shift; fi; {{bounded}} 1800 cargo run --locked -q -p xtask -- mac deploy {{VERSION}} "$@"
