    { "tick": 1100 },
    { "input": { "id": "p1", "prompt": { "text": "summarise the readme" } } },
    { "fact": { "channel": "stream", "json": { "type": "user", "id": "u1", "text": "summarise the readme" } } },
    { "fact": { "channel": "stream", "json": { "type": "text", "id": "m1", "delta": "It describes " } } },
    { "fact": { "channel": "stream", "json": { "type": "text", "id": "m1", "delta": "the build." } } },
    { "fact": { "channel": "stream", "json": { "type": "text_done", "id": "m1" } } },
    { "tick": 2000 },
    { "fact": { "channel": "stream", "json": { "type": "turn_end" } } }
  ]
