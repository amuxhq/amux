<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Store distribution shape. The export itself stays local:
	     `destination` is `export`, and nothing here uploads. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<!-- Manual, not automatic. Xcode's cloud signing cannot mint or fetch a
	     profile for this account from a script: it answers "Cloud signing
	     permission error" and then claims no profile exists, even with an
	     active matching one installed. So the export names the certificate
	     and the profile itself. Both must already be on the Mac, and a
	     preflight run says so when they are not; see docs/RELEASE.md. -->
	<key>signingStyle</key>
	<string>manual</string>
	<!-- The certificate type, not one certificate's full name: the full name
	     ends in the Team ID and this file is committed. Together with teamID
	     it picks the distribution identity in the login keychain. -->
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>sh.amux.app</key>
		<string>amux App Store</string>
		<key>sh.amux.app.notifications</key>
		<string>amux Notifications App Store</string>
	</dict>
	<!-- Xcode may otherwise rewrite the build number while exporting. The
	     number this repository derived, wrote and tagged is the number that
	     ships; see docs/RELEASE.md. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
	<!-- teamID is deliberately absent: it identifies a team and this file is
	     committed. `just ios release` copies this file and inserts the Team ID
	     from the untracked apps/apple/Signing.local.xcconfig. -->
</dict>
</plist>
