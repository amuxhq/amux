#!/bin/sh
# The testnet's stand-in for ssh, first on the PATH of every story. A
# target is a testnet host's directory, as `Net::ssh_target` names it, and
# the command after it runs as sshd would run it on a real machine: as one
# string, through a shell. amux sends `sh -c '<find amux>' amux ARGS`, and
# there `amux` is the far host's own, through the login the net wrote in
# the target, first on the PATH: `amux relay --profile <id>` joins this
# process's stdio to the far host's link socket. Options are skipped, as
# ssh's own would not change where this lands, and so is a user before the
# target's `@`.
while [ $# -gt 0 ]; do
    case $1 in
        --) shift; break ;;
        -[bcDEeFIiJLlmOoPpQRSWw]) shift 2 ;;
        -*) shift ;;
        *) break ;;
    esac
done
if [ $# -eq 0 ]; then
    echo "usage: ssh [options] target command" >&2
    exit 255
fi
target=${1#*@}
shift
if [ ! -x "$target/ssh-path/amux" ]; then
    echo "ssh: Could not resolve hostname $target: no testnet host there" >&2
    exit 255
fi
case "$*" in
    "sh -c '"*"' amux "*) ;;
    *)
        echo "ssh: the testnet's stand-in runs only amux's own command, not: $*" >&2
        exit 255
        ;;
esac
PATH="$target/ssh-path:$PATH"
export PATH
exec sh -c "$*"
