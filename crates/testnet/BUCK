TEST_DEPS = [
    "//crates/analytics:analytics",
    "//crates/app-runtime:app-runtime",
    "//crates/ui-runtime:ui-runtime",
    "//crates/ui-state:ui-state",
    "//crates/ui-view:ui-view",
]

amux_rust_library(
    version = "0.1.0",
    tool = True,
    deps = DEPS,
    test_deps = TEST_DEPS,
    include = {"//:qa/FINDING.md": "qa/FINDING.md"},
    test_resources = ["//crates/interpret:fixtures", "//:environments", "//:journeys", "//:performance"],
    binaries = True,
)

amux_rust_binary(
    name = "testnet",
    version = "0.1.0",
    crate_root = "src/bin/testnet.rs",
    deps = DEPS,
    tool = True,
)

amux_rust_test(
    name = "integration",
    version = "0.1.0",
    deps = DEPS + TEST_DEPS,
    run_env = {
        "CARGO_BIN_EXE_testnet": "$(location :testnet-bin)",
    },
    include = {"//:qa/FINDING.md": "qa/FINDING.md"},
    resources = ["//crates/interpret:fixtures", "//:environments", "//:journeys"],
    binaries = True,
    # Eight cases at a time (Windows keeps its two). This is the workspace's
    # longest test target, some 180 link stories that each spend most of
    # their time waiting on the net, and it builds last, above node and
    # testnet: at four it ran alone for minutes at the end of every run
    # after a change to a crate below it.
    timeouts = {"threads": select({
        "DEFAULT": 8,
        "prelude//os:windows": 2,
    })},
    runs = {
        # The stories that also run on the simulated net (`modes` in
        # tests/catalog.toml), there: every core in one process, walked by
        # a few seeds each. A failure prints the seed and the `just sim
        # --seed` that reruns it.
        "simulated": {
            "env": {"TESTNET_MODE": "simulated"},
            "filters": ["^family_stories::", "^harness_stories::", "^replication_stories::", "^sim_harness::", "^sim_seeds::"],
            "labels": ["simulated"],
        },
    },
)

# Every terminal journey (`just journey terminal all`): the built binaries
# on the fake providers in tmux, each story's screens held to its goldens.
# A test of this machine's build, as the crates' tests are, so a Mac runs
# the macOS journeys and the build host the Linux ones; cached until a
# binary, a story or a golden changes.
amux_check(
    name = "terminal-journeys",
    command = [
        "sh",
        "-c",
        "TESTNET_BINARIES=$PWD/$TESTNET_BINARIES AMUX_SOURCE_ROOT=$PWD exec \"$1\" journey terminal all",
        "sh",
        "$(location :testnet-bin)",
    ],
    # The crate's own files only so that its directory, which the journeys
    # find the checkout from, is there.
    deps = [":files", "//:journeys", "//crates/provider-fakes:binaries"],
    env = {"TESTNET_BINARIES": "$(location //crates/provider-fakes:binaries)"},
    labels = ["journey"],
    host = True,
    # Out of scope on Windows: the TUI (the terminal client, in tmux), so a
    # Windows build skips them as `just test-windows` leaves out `journey`.
    target_compatible_with = select({
        "DEFAULT": [],
        "prelude//os:windows": ["prelude//:none"],
    }),
    # The stories run half the machine's cores at once, each a set of
    # daemons in tmux on a clock; beside other tests they miss their waits,
    # as they did beside the models on the build host. They had the machine
    # to themselves when premerge ran them after the tests.
    remote_execution = "whole-worker",
)

# The integration binary's suites and this file's simulated run, which the
# suite catalogue's tests hold to tests/catalog.toml (the root BUCK's
# script tests).
amux_files(
    name = "suites",
    srcs = glob(["tests/**/*.rs"]) + ["BUCK"],
)
