{
  "about": "A person's prompts from two clients share one queue: submitted when the provider is idle, queued while it works, withdrawable until submitted, drained in order at each turn end.",
  "spec": { "created_at_ms": 1000 },
  "events": [
    { "input": { "id": "early", "prompt": { "text": "before the provider is up" } },
      "expect": { "reply": "queued", "queue": ["early"], "phase": "STARTING" } },
    { "tick": 1100 },
    { "fact": { "channel": "stream", "json": { "type": "ready" } },
      "note": "the provider accepts input: the queued prompt is submitted",
      "expect": { "phase": "WORKING", "queue": [], "effects": ["write \"{\\\"text\\\":\\\"before the provider is up\\\",\\\"type\\\":\\\"user\\\"}\""] } },
    { "fact": { "channel": "stream", "json": { "type": "user", "id": "u1", "text": "before the provider is up" } },
      "expect": { "items": ["u1"] } },
    { "fact": { "channel": "stream", "json": { "type": "turn_end" } },
      "expect": { "phase": "IDLE", "turn_end": { "turn_id": 1, "last_message_key": "" } } },
    { "tick": 2000 },
    { "input": { "id": "p1", "prompt": { "text": "first" } },
      "expect": { "reply": "accepted", "phase": "WORKING", "queue": [] } },
    { "input": { "id": "p2", "prompt": { "text": "from the phone" } },
      "note": "a second client's prompt lands in the same queue",
      "expect": { "reply": "queued", "queue": ["p2"] } },
    { "input": { "id": "p3", "prompt": { "text": "from the terminal" } },
      "expect": { "reply": "queued", "queue": ["p2", "p3"] } },
    { "input": { "id": "w1", "withdraw": { "target": "p3" } },
      "expect": { "reply": "accepted", "queue": ["p2"] } },
    { "input": { "id": "w2", "withdraw": { "target": "p3" } },
      "note": "already gone: rejected, and nothing is written",
      "expect": { "reply": "rejected:NOT_QUEUED", "silent": true } },
    { "fact": { "channel": "stream", "json": { "type": "user", "id": "u2", "text": "first" } },
      "expect": { "items": ["u2"] } },
    { "fact": { "channel": "stream", "json": { "type": "text", "id": "m1", "delta": "done" } } },
    { "fact": { "channel": "stream", "json": { "type": "text_done", "id": "m1" } } },
    { "tick": 3000 },
    { "fact": { "channel": "stream", "json": { "type": "turn_end" } },
      "note": "the turn ends: the head of the queue is submitted at once",
      "expect": { "turn_end": { "turn_id": 2, "last_message_key": "m1" }, "phase": "WORKING", "queue": [] } },
    { "input": { "id": "w3", "withdraw": { "target": "p2" } },
      "note": "the one-round-trip race: the turn ended before the withdraw landed",
      "expect": { "reply": "rejected:NOT_QUEUED", "silent": true } },
    { "fact": { "channel": "stream", "json": { "type": "user", "id": "u3", "text": "from the phone" } } },
    { "fact": { "channel": "stream", "json": { "type": "turn_end" } },
      "expect": { "phase": "IDLE", "turn_end": { "turn_id": 3, "last_message_key": "" } } },
    { "input": { "id": "x1", "raw": { "hex": "" } },
      "note": "an input with no arm this version can read",
      "expect": { "reply": "rejected:UNSUPPORTED", "silent": true } }
  ]
}
