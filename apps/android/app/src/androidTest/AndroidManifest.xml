    package="sh.amux.android.test">
    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="36" />
    <instrumentation
        android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="sh.amux.android" />
</manifest>
