{
  "about": "Inputs become stream-JSON writes: prompts wait for the provider and a running turn, carrying their input id as the message uuid; model, mode and effort changes are control requests whose success reaches the snapshot, and after a model change Claude is asked which effort it applied; clear is a /clear message; interrupt is a control request only while something runs. An agent message goes to Claude's own queue on stdin at once and is its own row.",
  "spec": {
    "created_at_ms": 1800000000000
  },
  "events": [
    {
      "input": {
        "id": "p1",
        "prompt": {
          "text": "first"
        }
      },
      "expect": {
        "reply": "queued",
        "phase": "STARTING"
      }
    },
    {
      "fact": {
        "channel": "stream",
        "json": {
          "type": "system",
          "subtype": "init",
          "uuid": "init-s1",
          "session_id": "s1",
          "claude_code_version": "2.1.282",
          "model": "claude-opus-5-5",
          "permissionMode": "default"
        }
      },
      "expect": {
        "phase": "WORKING",
        "queue": []
      }
    },
    {
      "input": {
        "id": "p2",
        "prompt": {
          "text": "second"
        }
      },
      "expect": {
        "reply": "queued",
        "queue": [
          "p2"
        ]
      }
    },
    {
      "input": {
        "id": "w1",
        "withdraw": {
          "target": "p2"
        }
      },
      "expect": {
        "reply": "accepted",
        "queue": []
      }
    },
    {
      "input": {
        "id": "i1",
        "interrupt": {}
      },
      "expect": {
        "reply": "accepted"
      }
    },
    {
      "fact": {
        "channel": "stream",
        "json": {
          "type": "user",
          "uuid": "u1",
          "message": {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "[Request interrupted by user]"
              }
            ]
          }
        }
      },
      "expect": {
        "silent": true
      }
    },
    {
      "fact": {
        "channel": "stream",
        "json": {
          "type": "result",
          "subtype": "error_during_execution",
          "uuid": "r1",
          "duration_ms": 1000,
          "total_cost_usd": 0.01,
          "is_error": true,
          "terminal_reason": "aborted_streaming"
        }
      },
      "expect": {
        "phase": "IDLE",
        "turn_end": {
          "turn_id": 1,
          "last_message_key": ""
        }
      }
    },
    {
      "input": {
        "id": "i2",
        "interrupt": {}
      },
      "expect": {
        "reply": "accepted",
        "effects": [
          "reply i2 accepted"
        ]
      }
    },
    {
      "input": {
        "id": "m1",
        "model": {
          "model": "claude-sonnet-5"
        }
      },
      "expect": {
        "reply": "accepted",
        "effects": [
          "write \"{\\\"request\\\":{\\\"model\\\":\\\"claude-sonnet-5\\\",\\\"subtype\\\":\\\"set_model\\\"},\\\"request_id\\\":\\\"amux-2\\\",\\\"type\\\":\\\"control_request\\\"}\"",
          "reply m1 accepted"
        ]
      }
    },
    {
      "fact": {
        "channel": "stream",
        "json": {
          "type": "control_response",
          "response": {
            "subtype": "success",
            "request_id": "amux-2",
            "response": {}
          }
        }
      }
    },
    {
      "fact": {
        "channel": "stream",
        "json": {
          "type": "control_response",
          "response": {
            "subtype": "success",
            "request_id": "amux-3",
            "response": {
              "applied": {
                "model": "claude-sonnet-5",
                "effort": "medium"
              }
            }
          }
        }
      }
    },
    {
      "input": {
        "id": "m2",
        "permission": {
          "value": "plan"
        }
      },
      "expect": {
        "reply": "accepted"
      }
    },
    {
      "fact": {
        "channel": "stream",
        "json": {
          "type": "control_response",
          "response": {
            "subtype": "success",
            "request_id": "amux-4",
            "response": {
              "mode": "plan"
            }
          }
        }
      }
    },
    {
      "input": {
        "id": "e1",
        "effort": {
          "effort": "high"
        }
      },
      "expect": {
        "reply": "accepted"
      }
    },
    {
      "fact": {
        "channel": "stream",
        "json": {
          "type": "control_response",
          "response": {
            "subtype": "success",
            "request_id": "amux-5",
            "response": {}
          }
        }
      }
    },
    {
      "input": {
        "id": "c1",
        "clear": {}
      },
      "expect": {
        "reply": "accepted"
      }
    },
    {
      "fact": {
        "channel": "stream",
        "json": {
          "type": "conversation_reset",
          "uuid": "cr",
          "new_conversation_id": "s2"
        }
      }
    },
    {
      "fact": {
        "channel": "stream",
        "json": {
          "type": "result",
          "subtype": "success",
          "uuid": "r2",
          "duration_ms": 1000,
          "total_cost_usd": 0.01,
          "is_error": false
        }
      },
      "expect": {
        "phase": "IDLE"
      }
    },
    {
      "agent_message": {
        "envelope": "env-1",
        "from": "reviewer",
        "text": "please look at the diff"
      }
    }
  ]
}
