# The Android app's recipes. `just android <recipe>` from anywhere in the
# checkout; every recipe runs from the repository root so paths mean the same
# thing in the scripts, Buck2 and the Rust workspace. Buck2 builds and tests
# the app on a Linux worker (the build host's), never on the Mac
# (docs/ANDROID.md); the device recipes install what it built from the
# cache.

set shell := ["sh", "-cu"]
set positional-arguments
set working-directory := "../.."

# Wall-clock bound for every recipe; portable where GNU timeout is absent.
bounded := "scripts/bounded"

# The interpreter these scripts are written to, chosen rather than assumed;
# scripts/py explains why and picks it.
python := "scripts/py"

# The pinned Buck2 (docs/BUILD.md).
buck2 := "scripts/buck2"

# List the Android app's recipes.
default:
    @just --list android

# Build the JNI bridge for Android as the app ships it and as a driving build carries it.
check:
    {{bounded}} 3000 {{buck2}} build //apps/android/app:jni-release //apps/android/app:jni-debug

# Check the Kotlin sources and string resources against the app's writing
# rules. The generated Kotlin mirrors and markdown fixtures are held to their
# Rust sources by ios-tools' own tests, which `just premerge` and CI run.
lint:
    {{bounded}} 900 {{buck2}} test //apps/android:feature-lint //apps/android:strings-lint //apps/android:test-waits-lint

# The driving tools are the one deliberate exception, checked below with
# them enabled.
#
# Prove the JNI bridge graph carries no provider, host or test crate onto the phone.
graph-check:
    mkdir -p target/android
    {{bounded}} 300 cargo tree --locked -p app-jni --target aarch64-linux-android -e normal --prefix none --format "{p}" > target/android/graph-shipping.txt
    ! grep -E "^(pty-host|agent|interpret|claude-protocol|codex-protocol|schemars|testnet|qualification|replay-support) v" target/android/graph-shipping.txt
    {{bounded}} 300 cargo tree --locked -p app-jni --features debug-tools --target aarch64-linux-android -e normal --prefix none --format "{p}" > target/android/graph-driving.txt
    ! grep -E "^(pty-host|agent|interpret|claude-protocol|codex-protocol|schemars) v" target/android/graph-driving.txt

# Boot and pin the Android emulator AVD (`amux-android-1`).
emulator *ARGS:
    {{bounded}} 600 {{python}} -B apps/android/tools/android-emulator.py "$@"

# Build the debug Android APK and print where it is.
build *ARGS:
    {{bounded}} 3000 scripts/built //apps/android/app:debug "$@"

# Drive the Android app on the pinned emulator against real daemons and a real relay.
journey *ARGS:
    #!/usr/bin/env sh
    set -eu
    if [ "${1-}" = -- ]; then shift; fi
    AMUX_ANDROID_APK=$({{bounded}} 3000 scripts/built //apps/android/app:debug)
    TESTNET_BINARIES=$({{bounded}} 900 scripts/built //crates/provider-fakes:binaries)
    testnet=$({{bounded}} 900 scripts/built //crates/testnet:testnet-bin)
    export AMUX_ANDROID_APK TESTNET_BINARIES
    exec {{bounded}} 2400 "$testnet" journey android "$@"

# Run all JVM and Android Robolectric unit test suites, the accessibility audit and scope-audit among them.
unit *ARGS:
    {{bounded}} 3600 {{buck2}} test //apps/android/... "$@"

# Run the automated Compose accessibility audit across every registered story.
accessibility *ARGS:
    {{bounded}} 1800 {{buck2}} test //apps/android/app:accessibility "$@"

# Render the headless Robolectric/Roborazzi storybook gallery.
storybook *ARGS:
    {{bounded}} 1800 {{python}} -B apps/android/tools/android-storybook.py "$@"

# Prove the app bundle ships no debug/test code or dynamic SQLite.
scope-audit *ARGS:
    {{bounded}} 3000 {{buck2}} test //apps/android/app:scope-audit "$@"

# The runtime starts, steps, acts, and refuses a call through the bridge, on
# the device ANDROID_SERIAL names or else the pinned emulator.
# Run the launch smoke test on the minified release APK.
release-smoke *ARGS:
    if [ -z "${ANDROID_SERIAL-}" ]; then {{bounded}} 600 {{python}} -B apps/android/tools/android-emulator.py >&2 && ANDROID_SERIAL=$({{python}} -B apps/android/tools/android-emulator.py --serial) && export ANDROID_SERIAL; fi; {{bounded}} 3600 {{python}} -B apps/android/tools/android-release-smoke.py "$@"

# Run the unit tests of the Android recipe and lint scripts.
script-tests:
    {{bounded}} 120 {{python}} -m unittest discover -s apps/android/tools/tests -p '*_test.py' -t apps/android/tools/tests

# Version, audit, build, sign, verify and upload the Android App Bundle (.aab)
# to Google Play internal testing, then commit, tag `android-v<version>-b<build>`
# and push (--preflight reports inputs immediately; --rehearse builds and verifies
# without writing the tree or tagging; --no-upload and --no-push stop short).
# Version, sign, verify and upload the Android bundle, then tag and push.
release *ARGS:
    if [ "${1-}" = -- ]; then shift; fi; {{bounded}} 4800 {{python}} -B apps/android/tools/android-release.py "$@"

# Promote a released Android versionCode on Google Play (`--channel stable|preview|closed|internal`,
# `--track NAME`, `--rollout PCT`, `--notes-file PATH`, `--draft`, `--dry-run`).
# Put a released Android build in front of people on Google Play.
deploy VERSION *ARGS:
    shift; if [ "${1-}" = -- ]; then shift; fi; {{bounded}} 600 {{python}} -B apps/android/tools/android-deploy.py deploy {{VERSION}} "$@"

# Show what each Google Play track currently holds for sh.amux.android.
status:
    {{bounded}} 120 {{python}} -B apps/android/tools/android-deploy.py status

# Run the full Android verification gate in deterministic order. `unit`
# runs the accessibility audit and scope-audit with the rest of the tests.
verify:
    just android lint
    just android graph-check
    just android script-tests
    just android unit
    just android storybook fleet.busy
    just android release-smoke
    just android journey
