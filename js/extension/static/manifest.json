{
  "manifest_version": 3,
  "name": "amux",
  "description": "Comment on any page and send the comments to an amux agent.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": { "default_title": "Review this page with amux" },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "panel.html" },
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging", "sidePanel", "contextMenus"],
  "commands": {
    "toggle-review": {
      "suggested_key": { "default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period" },
      "description": "Review this page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
