load("//build:checks.bzl", "amux_script_tests")
load("//build:rust.bzl", "amux_files")

# The Android app's scripts that Buck2 runs as checks of what it built.

export_file(
    name = "android-scope-audit.py",
    src = "android-scope-audit.py",
    visibility = ["PUBLIC"],
)

export_file(
    name = "google-services.py",
    src = "google-services.py",
    visibility = ["PUBLIC"],
)

export_file(
    name = "apk-contents.py",
    src = "apk-contents.py",
    visibility = ["PUBLIC"],
)

[
    export_file(
        name = script,
        src = script,
        # Run from where it is: the scripts find the checkout from their own
        # path.
        mode = "reference",
        visibility = ["PUBLIC"],
    )
    for script in ["feature-lint.sh", "strings_lint.py", "test-waits-lint.sh"]
]

amux_files(
    name = "noncopy",
    srcs = ["noncopy.json"],
)

# The unit tests of these scripts, one check per file
# (`:android-script-tests-android_release`), each over the scripts here: as
# repository checks (build/checks.bzl), so they run on the machine's own
# worker too when no Linux worker is in reach.
amux_script_tests(
    prefix = "android-script-tests",
    tests = glob(["tests/*_test.py"]),
    srcs = glob(["*", "tests/*.py"], exclude = ["BUCK"]),
    deps = ["//:app-script-helpers"],
    extra = {
        "android_release": {"deps": ["//apps/android/app:version"]},
    },
)
