# Constraints the prelude doesn't define (docs/BUILD.md, "Configurations").

# An iOS build is either for a device or for the simulator; the two are
# different Rust targets (aarch64-apple-ios and aarch64-apple-ios-sim).
constraint_setting(
    name = "apple-sdk",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "device",
    constraint_setting = ":apple-sdk",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "simulator",
    constraint_setting = ":apple-sdk",
    visibility = ["PUBLIC"],
)

# What a build is for, which decides the features of the workspace's own
# crates. Cargo unifies features per build: `cargo build -p amux` turns on
# what amux's graph asks for, `cargo build -p app-ffi` what the bridge's
# does, and `cargo test` adds what dev-dependencies ask for. A Buck target
# has one feature list per configuration, so the build's purpose is a
# constraint and each crate selects its features on it.
#
#   cli      the desktop product: amux, the daemon, the relay.
#   app      a client app's bridge: app-ffi, app-jni, browser-core.
constraint_setting(
    name = "product",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "cli",
    constraint_setting = ":product",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "app",
    constraint_setting = ":product",
    visibility = ["PUBLIC"],
)

# Tests, test harnesses and build tools. Turns on the features only
# dev-dependencies and test infrastructure ask for: release's test key,
# journal's synthetic records, store's exploration hooks and the like.
# Nothing shipped is built in this configuration.
constraint_setting(
    name = "purpose",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "shipping",
    constraint_setting = ":purpose",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "testing",
    constraint_setting = ":purpose",
    visibility = ["PUBLIC"],
)

# Cargo's profiles (Cargo.toml's [profile.*]).
constraint_setting(
    name = "mode",
    visibility = ["PUBLIC"],
)

[
    constraint_value(
        name = mode,
        constraint_setting = ":mode",
        visibility = ["PUBLIC"],
    )
    for mode in ["dev", "models", "release", "phone-dev", "wasm", "full-debug"]
]

# Whether a Linux worker is in reach (scripts/buck-config.py writes
# `amux.linux`). Targets that run only on Linux workers (`nova_only` in
# build/rust.bzl) are compatible only with it, so with nova unreachable a
# pattern such as //crates/... skips them, and says so, rather than trying
# to run them on the Mac.
config_setting(
    name = "linux-workers",
    values = {"amux.linux": "true"},
    visibility = ["PUBLIC"],
)

# A release build (scripts/release-build.py writes `amux.local`): every
# action on this machine, with this machine's own toolchains, rustup's Rust
# and the system's C compiler, and nothing from a cache, so what ships is
# built from scratch where it is built. Nix's Linux toolchain would link a
# binary that runs only where Nix's C library is. The root cell's value:
# `values` reads the cell of the target being configured, and the
# toolchains cell, which selects on this, has none.
config_setting(
    name = "local-build",
    root_values = {"amux.local": "true"},
    visibility = ["PUBLIC"],
)

# Built by the Linux toolchain on a Linux worker, wherever the build starts,
# for a target that isn't Linux itself: browser-core's WebAssembly as the
# JavaScript's Linux targets take it (js/BUCK). A Linux action can't read
# what a Mac's worker built, which stays in the Mac's cache.
constraint_setting(
    name = "builder",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "on-linux",
    constraint_setting = ":builder",
    visibility = ["PUBLIC"],
)

# The iPhone app's optimised build with its driving tools compiled in, which
# the performance suite measures (docs/IOS.md, "Builds"): the Swift is
# compiled as a release is, the bridge is the development one (`phone-dev`,
# with the driving tools). Only the Apple rules read it (build/apple.bzl);
# the bridge they link is configured without it.
constraint_setting(
    name = "apple-build",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "measured",
    constraint_setting = ":apple-build",
    visibility = ["PUBLIC"],
)
