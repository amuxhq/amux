{
  "about": "A one-shot child: a message from its parent arrives mid-turn, runs as a follow-up after the turn ends, and the child exits finished only at the follow-up's turn end.",
  "spec": { "created_at_ms": 1000 },
  "events": [
    { "fact": { "channel": "stream", "json": { "type": "ready" } } },
    { "input": { "id": "p1", "prompt": { "text": "review the diff" } } },
    { "fact": { "channel": "stream", "json": { "type": "user", "id": "u1", "text": "review the diff" } } },
    { "agent_message": { "envelope": "e1", "from": "parent", "text": "also check the tests" } },
    { "fact": { "channel": "stream", "json": { "type": "text", "id": "m1", "delta": "The diff reads well." } } },
    { "fact": { "channel": "stream", "json": { "type": "text_done", "id": "m1" } } },
    { "fact": { "channel": "stream", "json": { "type": "turn_end" } } },
    { "fact": { "channel": "stream", "json": { "type": "turn_start" } } },
    { "fact": { "channel": "stream", "json": { "type": "user", "envelope": "e1" } } },
    { "fact": { "channel": "stream", "json": { "type": "text", "id": "m2", "delta": "The tests cover it." } } },
    { "fact": { "channel": "stream", "json": { "type": "text_done", "id": "m2" } } },
    { "tick": 4000 },
    { "fact": { "channel": "stream", "json": { "type": "turn_end" } } },
    { "exiting": "finished" }
  ]
}
