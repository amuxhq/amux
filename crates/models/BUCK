    "//crates/relay-core:relay-core",
    "//crates/release:release",
    "//crates/socket-core:socket-core",
    "//crates/store:store",
    "//crates/supervisor-core:supervisor-core",
    "//crates/ui-state:ui-state",
    "//crates/wire:wire",
    "//crates/workspace-core:workspace-core",
    "//third-party/rust:prost",
    "//third-party/rust:rusqlite",
    "//third-party/rust:serde_json",
    "//third-party/rust:stateright",
    "//third-party/rust:tempfile",
    "//third-party/rust:uuid",
]

amux_rust_library(
    version = "0.1.0",
    tool = True,
    deps = DEPS,
    rustc_flags = OPTIMISED,
    test_timeouts = TIMEOUTS,
    test_whole_worker = True,
)

amux_rust_test(
    name = "integration",
    version = "0.1.0",
    deps = DEPS,
    rustc_flags = OPTIMISED,
    timeouts = TIMEOUTS,
    whole_worker = True,
    # Ten minutes on every core of a worker: on a laptop it holds up every
    # other tree's actions for that long.
    nova_only = True,
)
