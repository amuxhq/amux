#!/bin/sh
# Scan the commits a push would publish for credentials, before they leave.
#
# The repository is public, so a check that runs after the push (CI) can only
# report a leak that has already happened. This runs gitleaks, with the
# repository's .gitleaks.toml, over exactly the commits the remote does not
# have yet. `just hooks` installs it; `git push --no-verify` skips it.
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed (nix/toolchain.nix lists it); install it, or push with --no-verify." >&2
  exit 1
fi

status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # An all-zero local id deletes the remote ref, which publishes nothing.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  # An all-zero remote id is a new ref, and a forced push may name a commit
  # this clone has never fetched: scan what no remote-tracking ref holds.
  if case "$remote_sha" in *[!0]*) true ;; *) false ;; esac &&
    git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  else
    range="$local_sha --not --remotes"
  fi
  gitleaks git --no-banner --redact --log-opts="$range" . || status=1
done
exit "$status"
