]

# The Android app's toolchains (docs/ANDROID.md): the prelude's Java, Kotlin
# and Android toolchains, with the JDK and Android SDK from the Android Nix
# toolchain (android.bzl). Their actions run only on a Linux worker:
# `exec_compatible_with` on a toolchain carries to every target that uses
# it, so a Mac sends Android work to nova whatever it builds for.
_LINUX_EXEC = ["prelude//os:linux"]

_ANDROID_BUILD_TOOLS = "sdk/build-tools/36.0.0"

_ANDROID_PLATFORM = "sdk/platforms/android-36"

junit_java(name = "junit_java")

[
    android_tool(
        name = tool + "_tool",
        path = "bin/" + tool,
        visibility = ["PUBLIC"],
    )
    for tool in ["java", "javac", "jar", "jlink", "jmod"]
]

[
    android_tool(
        name = tool,
        path = path,
        visibility = ["PUBLIC"],
    )
    for tool, path in {
        "aapt2": _ANDROID_BUILD_TOOLS + "/aapt2",
        "aidl": _ANDROID_BUILD_TOOLS + "/aidl",
        "apksigner": _ANDROID_BUILD_TOOLS + "/apksigner",
        "zipalign": _ANDROID_BUILD_TOOLS + "/zipalign",
        "llvm-nm": NDK_BIN + "llvm-nm",
        "llvm-readelf": NDK_BIN + "llvm-readelf",
        "llvm-strip": NDK_BIN + "llvm-strip",
        "adb": "sdk/platform-tools/adb",
    }.items()
]

android_file(
    name = "jrt_fs_jar",
    path = "jdk/lib/jrt-fs.jar",
    visibility = ["PUBLIC"],
)

[
    android_file(
        name = name,
        path = _ANDROID_PLATFORM + "/" + name,
        visibility = ["PUBLIC"],
    )
    for name in ["android.jar", "core-for-system-modules.jar", "framework.aidl"]
]

android_sdk(
    name = "android_sdk_tools",
    files = {
        "android.jar": ":android.jar",
        "core-for-system-modules.jar": ":core-for-system-modules.jar",
        "framework.aidl": ":framework.aidl",
        "optimized_proguard_config": "root//build/android:proguard-android-optimize.txt",
        "proguard_config": "root//build/android:proguard-android-optimize.txt",
        # Never run: android-inner gives the toolchain R8 in its place.
        "proguard.jar": "root//build/android:proguard-android-optimize.txt",
    },
    tools = {
        "aapt2": ":aapt2",
        "adb": ":adb",
        "aidl": ":aidl",
        "zipalign": ":zipalign",
    },
)

jdk_system_image(
    name = "jdk_system_image",
    core_for_system_modules_jar = ":android_sdk_tools[core-for-system-modules.jar]",
)

# Each toolchain is defined under `<name>-inner` by the prelude's macro and
# published under its own name as Linux-only (linux_toolchain).
system_android_toolchain(
    name = "android-prelude",
    android_sdk_tools_target = ":android_sdk_tools",
    jdk_system_image = ":jdk_system_image",
)

android_toolchain_with(
    name = "android-inner",
    actual = ":android-prelude",
    replace = {
        "generate_manifest": "root//build/android/manifest:generate_manifest",
        "replace_application_id_placeholders": "root//build/android/manifest:replace_application_id_placeholders",
        "jar_splitter_command": "root//build/android/dex:jar_splitter",
        "multi_dex_command": "root//build/android/dex:multi_dex",
    },
    # R8, which the SDK's tools can't carry: it is a jar built with the dex
    # toolchain, which is built from them.
    replace_files = {"proguard_jar": "root//build/android:r8-compat-proguard"},
)

system_android_aidl_toolchain(
    name = "android_aidl-inner",
    android_sdk_tools_target = ":android_sdk_tools",
)

system_dex_toolchain(
    name = "dex-inner",
    android_sdk_tools_target = ":android_sdk_tools",
)

[
    javacd_toolchain(
        name = name + ("-prelude" if name == "java_for_android" else "-inner"),
        java = ":java_tool",
        javac = ":javac_tool",
        jar = ":jar_tool",
        jlink = ":jlink_tool",
        jmod = ":jmod_tool",
        jrt_fs_jar = ":jrt_fs_jar",
        java_for_tests = ":junit_java",
    )
    for name in ["java", "java_for_android", "java_for_host_test"]
]

# R8 shrinks the whole app in one JVM, run with this heap (the prelude's
# default is none, which the JVM refuses as `-XmxNone`).
java_toolchain_with(
    name = "java_for_android-inner",
    actual = ":java_for_android-prelude",
    values = {"proguard_max_heap_size": "6g"},
)

system_java_bootstrap_toolchain(
